From f3fb19f435cda83f15ae0becbb53af1c06bf7bdc Mon Sep 17 00:00:00 2001
From: mtlcl410 <2368091+mtlcl410@users.noreply.github.com>
Date: Mon, 23 Nov 2026 01:29:28 +0800
Subject: [PATCH] Allow an isolated muted capture strip during dry-guide chase

---
 crates/playback/src/mtc/tests/silent_preroll.rs |  5 +++++
 crates/playback/src/mtc_preroll.rs              | 11 ++++++++---
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/crates/playback/src/mtc/tests/silent_preroll.rs b/crates/playback/src/mtc/tests/silent_preroll.rs
index f073efe1..f7a0838d 100644
--- a/crates/playback/src/mtc/tests/silent_preroll.rs
+++ b/crates/playback/src/mtc/tests/silent_preroll.rs
@@ -50,6 +50,11 @@ fn a_dry_lead_in_starts_the_same_pcm_with_a_locate_or_a_rolling_join() {
         s.pool.insert(SourceId(1), Arc::new(SourceAudio::new(craft_audio::AudioBuffer { sample_rate: 48000, channels: vec![wave] })));
         let id = s.new_clip_id();
         s.track_mut(t).unwrap().playlist_mut().unwrap().clips.push(Clip::audio(id, "guide", SourceId(1), 0, 0, len));
+        // The hardware acceptance routes USB input to an armed, muted meter strip.
+        let meter = s.add_track(TrackKind::Audio, ChannelFormat::Mono, None);
+        let mixer = &mut s.track_mut(meter).unwrap().mixer;
+        mixer.mute = true;
+        mixer.record_arm = true;
         let (mut audio, tx, _) = callback(s, 48000.);
         let feed = Arc::new(MidiFeed::default());
         feed.set_mtc_source(Some(0));
diff --git a/crates/playback/src/mtc_preroll.rs b/crates/playback/src/mtc_preroll.rs
index 6f5b1671..94c57b2e 100644
--- a/crates/playback/src/mtc_preroll.rs
+++ b/crates/playback/src/mtc_preroll.rs
@@ -17,9 +17,6 @@ pub(crate) fn silent_pcm_prefix(s: &Session, from: i64, to: i64) -> bool {
             || track.instrument.is_some()
             || track.elastic.is_some()
             || !track.automation.is_empty()
-            || mixer.record_arm
-            || mixer.input_monitor
-            || mixer.input != Route::None
             || mixer.inserts.len() > 16
             || mixer.sends.len() > 16
             || mixer.inserts.iter().any(Option::is_some)
@@ -28,6 +25,14 @@ pub(crate) fn silent_pcm_prefix(s: &Session, from: i64, to: i64) -> bool {
             return false;
         }
         let Some(playlist) = track.playlist() else { return false };
+        // A muted, empty recording strip with no inserts, sends or automation
+        // cannot contribute to a dry guide. Arming it for metering is common.
+        if track.kind == TrackKind::Audio && mixer.mute && playlist.clips.is_empty() {
+            continue;
+        }
+        if mixer.record_arm || mixer.input_monitor || mixer.input != Route::None {
+            return false;
+        }
         if playlist.clips.len() > clips_left {
             return false;
         }
-- 
