+#[test]
+fn b8_unsynced_device_reset_retained_then_unknown_then_fresh() {
+    let out = Output::default();
+    let base = Instant::now();
+    let mut publisher = Publisher::new(out.view.clone(), out.metrics.clone());
+    let mut local = crate::sync_clock::StreamLead::default();
+    let mut pcm = Vec::new();
+    let mut reset_pcm = Vec::new();
+    let mut cursor = 0;
+    let mut mix = soundcraft_mix::MixEngine::new(48000., 480);
+    let mut candidate_mix = soundcraft_mix::MixEngine::new(48000., 480);
+    let mut candidate_block = vec![vec![0.; 480]; 2];
+    let mut song = Session::default();
+    let track = song.add_track(soundcraft_model::TrackKind::Audio, soundcraft_model::ChannelFormat::Stereo, None);
+    let clip_id = song.new_clip_id();
+    let src = soundcraft_model::SourceId(1700);
+    song.pool.insert(
+        src,
+        Arc::new(soundcraft_model::SourceAudio::new(craft_audio::AudioBuffer { sample_rate: 48000, channels: vec![vec![0.25; 3360]; 2] })),
+    );
+    song.track_mut(track).unwrap().playlist_mut().unwrap().clips.push(soundcraft_model::Clip::audio(clip_id, "tone", src, 0, 0, 3360));
+    let mut buf = vec![vec![0.; 480]; 2];
+    for i in 0..7 {
+        if i == 4 {
+            local = Default::default();
+        }
+        let report = match i {
+            0 | 1 | 6 => Some(Duration::from_millis(12)),
+            _ => None,
+        };
+        publisher.observe(local.observe(base + Duration::from_millis(i * 10), report), 0.01);
+        let source = out.status().lead_source;
+        let warning = out.timing_issue();
+        println!("B8 t_ms={} lead={source:?} warning={warning:?}", i * 10);
+        // The active route is retained: render an unbroken reference signal on the same graph.
+        mix.render(&song, cursor, 480, &mut buf);
+        pcm.extend_from_slice(&buf[0]);
+        // A capture device on the same wall-time grid sees no delivered samples for
+        // exactly two dropped output callbacks; the healthy reference still renders.
+        if matches!(i, 3 | 4) {
+            reset_pcm.resize(reset_pcm.len() + 480, 0.);
+        } else {
+            candidate_mix.render(&song, cursor, 480, &mut candidate_block);
+            reset_pcm.extend_from_slice(&candidate_block[0]);
+        }
+        cursor += 480;
+    }
+    assert_eq!(out.status().lead_source, crate::OutputLeadSource::Reported);
+    assert!(out.timing_issue().is_none());
+    assert_eq!(pcm.len(), 3360);
+    let zeros = pcm.iter().filter(|x| x.abs() < 0.001).count();
+    println!("B8 rendered={} near_zero={zeros} output_gap_ms={}", pcm.len(), zeros as f64 / 48.);
+    assert_eq!(zeros, 0);
+    let muted = reset_pcm
+        .iter()
+        .zip(&pcm)
+        .enumerate()
+        .filter_map(|(i, (actual, reference))| (actual - reference).abs().gt(&0.001).then_some(i))
+        .collect::<Vec<_>>();
+    let start = *muted.first().unwrap();
+    let end = *muted.last().unwrap() + 1;
+    println!(
+        "B8 injected_reopen_frames=960 observed_difference={start}..{end} extra_gap_samples={} gap_ms={}",
+        muted.len().abs_diff(960),
+        muted.len() as f64 / 48.
+    );
+    assert_eq!(muted, (1440..2400).collect::<Vec<_>>());
+}
+#[test]
+fn a8_one_dropped_output_preserves_other_ports_and_rejoins_on_grid() {
+    struct Wire {
+        name: String,
+        first: bool,
+        clocks: usize,
+        tx: Sender<(String, bool, Instant, Instant, Vec<u8>)>,
+    }
+    impl SyncPort for Wire {
+        fn send_at(&mut self, at: Instant, msg: &[u8]) -> Result<Instant, String> {
+            if msg == [CLOCK] {
+                self.clocks += 1;
+            }
+            if self.first && self.clocks == 8 {
+                return Err("device gone".into());
+            }
+            let actual = Instant::now();
+            self.tx.send((self.name.clone(), self.first, at, actual, msg.to_vec())).unwrap();
+            Ok(actual)
+        }
+    }
+    let out = Output::default();
+    let stats = out.stats.clone();
+    let err = out.trouble.clone();
+    let view = out.view.clone();
+    let t0 = Instant::now() + Duration::from_millis(80);
+    view.lock().unwrap().push(block(t0, 0., 192000., Duration::ZERO));
+    let (tx, rx) = channel();
+    let (evt, wire) = channel();
+    let worker = std::thread::spawn(move || {
+        let mut attempts = 0;
+        drive(view, Arc::new(Session::default()), rx, err, stats, move |name| {
+            let first = name == "A" && attempts == 0;
+            if name == "A" {
+                attempts += 1;
+            }
+            Ok((Wire { name: name.into(), first, clocks: 0, tx: evt.clone() }, None))
+        })
+    });
+    tx.send(Update::Beats(vec![("A".into(), 0), ("B".into(), 0)], true)).unwrap();
+    let mut right = Vec::new();
+    let mut reopened = Vec::new();
+    let mut lost = false;
+    let mut reopened_actual = Vec::new();
+    let limit = Instant::now() + Duration::from_secs(5);
+    while Instant::now() < limit {
+        if out.status().error.as_deref() == Some("A: device gone") {
+            lost = true;
+        }
+        if let Ok((name, first, at, actual, msg)) = wire.recv_timeout(Duration::from_millis(10)) {
+            if name == "B" && msg == [CLOCK] {
+                right.push(at);
+            }
+            if name == "A" && !first {
+                if msg == [CLOCK] {
+                    reopened_actual.push(actual);
+                }
+                reopened.push((at, msg));
+            }
+            if reopened.iter().filter(|(_, m)| m == &[CLOCK]).count() >= 4 {
+                break;
+            }
+        }
+    }
+    drop(tx);
+    worker.join().unwrap();
+    assert!(lost);
+    assert!(right.len() > 48, "other destination kept rolling");
+    let p = spp(&reopened.iter().map(|(_, m)| m.clone()).collect::<Vec<_>>()).unwrap();
+    let f8: Vec<_> = reopened.iter().filter(|(_, m)| m == &[CLOCK]).map(|(t, _)| *t).collect();
+    let err = distance(f8[0], t0 + Duration::from_secs_f64(p as f64 * 0.125));
+    let min = f8.windows(2).map(|w| w[1] - w[0]).min().unwrap();
+    println!(
+        "A8 status_lost={lost} healthy_clocks={} reconnect_spp={p} prefix={:?} phase_us={} min_clock_spacing_us={}",
+        right.len(),
+        reopened.iter().take(3).map(|(_, m)| m).collect::<Vec<_>>(),
+        err.as_micros(),
+        min.as_micros()
+    );
+    let true_phase = distance(reopened_actual[0], t0 + Duration::from_secs_f64(p as f64 * 0.125));
+    let true_min = reopened_actual.windows(2).map(|w| w[1] - w[0]).min().unwrap();
+    println!("A8 first_clock_actual_phase_us={} actual_min_spacing_us={}", true_phase.as_micros(), true_min.as_micros());
+    assert_eq!(reopened[0].1[0], 0xf2);
+    assert_eq!(reopened[1].1, [CONTINUE]);
+    assert!(err <= Duration::from_millis(2));
+    assert!(min >= Duration::from_millis(15));
+    assert!(right.windows(2).all(|w| (w[1] - w[0]) < Duration::from_millis(30)));
+}
