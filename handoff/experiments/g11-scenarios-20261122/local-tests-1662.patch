+/// This instrument sends one unit sample per quarter. The backing aux insert
+/// models a 2048-frame lookahead on a silent backing bus. The measured path is
+/// the mixer's PDC-delayed click, not a mathematically delayed reference buffer.
+struct ShowProcessor {
+    gain: Box<dyn soundcraft_dsp::Plugin>,
+    latency: usize,
+    quarter: usize,
+    frame: usize,
+}
+impl soundcraft_dsp::Plugin for ShowProcessor {
+    fn info(&self) -> &'static soundcraft_dsp::PluginInfo {
+        self.gain.info()
+    }
+    fn prepare(&mut self, sr: f32, n: usize, ch: usize) {
+        self.gain.prepare(sr, n, ch)
+    }
+    fn reset(&mut self) {
+        self.frame = 0
+    }
+    fn param(&self, id: &str) -> Option<f32> {
+        self.gain.param(id)
+    }
+    fn set_param(&mut self, id: &str, v: f32) -> bool {
+        self.gain.set_param(id, v)
+    }
+    fn latency(&self) -> usize {
+        self.latency
+    }
+    fn process(&mut self, io: &mut [Vec<f32>], frames: usize) {
+        if self.latency == 0 {
+            let offset = (self.quarter - self.frame % self.quarter) % self.quarter;
+            for ch in io {
+                ch[..frames].fill(0.);
+                for i in (offset..frames).step_by(self.quarter) {
+                    ch[i] = 0.25;
+                }
+            }
+        }
+        self.frame += frames;
+    }
+}
+fn pdc_show(beats: usize, hz: u32) {
+    use soundcraft_mix::{INSTRUMENT_SLOT, MixEngine, PreparedInstance};
+    use soundcraft_model::{ChannelFormat, Insert, TrackKind};
+    let mut s = Session::new("show", test_rate(hz));
+    let quarter = hz as usize / 2;
+    let stride = hz as usize / 2000;
+    s.edit.delay_compensation = true;
+    let click = s.add_track(TrackKind::Instrument, ChannelFormat::Stereo, None);
+    let aux = s.add_track(TrackKind::Aux, ChannelFormat::Stereo, None);
+    let mut engine = MixEngine::new(hz as f32, 4096);
+    engine.set_external_instances(true);
+    s.track_mut(click).unwrap().instrument = Some(Insert::new("clap:show.click"));
+    s.track_mut(aux).unwrap().mixer.inserts[0] = Some(Insert::new("clap:show.lookahead"));
+    for (track, slot, id, latency) in [(click, INSTRUMENT_SLOT, "clap:show.click", 0), (aux, 0, "clap:show.lookahead", 2048)] {
+        engine.adopt(vec![PreparedInstance {
+            track,
+            slot,
+            id: id.into(),
+            ch: 2,
+            plugin: Box::new(ShowProcessor { gain: soundcraft_dsp::create("gain").unwrap(), latency, quarter, frame: 0 }),
+        }]);
+    }
+    let n = beats * quarter;
+    let mut buf = vec![vec![0.; 4096]; 2];
+    let mut clicks = Vec::with_capacity(beats);
+    let mut clocks = Vec::with_capacity(beats + 1);
+    let view = View::default();
+    let stats = Stats::default();
+    let mut scratch = Vec::new();
+    let mut port = active_port(0, true);
+    let base = Instant::now();
+    let mut pulse = 0;
+    for pos in (0..n + 4096).step_by(4096) {
+        engine.render(&s, pos as i64, 4096, &mut buf);
+        assert_eq!(engine.latency, 2048);
+        for (i, x) in buf[0].iter().enumerate().take(4096) {
+            if x.abs() > 0.01 {
+                clicks.push(pos + i);
+            }
+        }
+        let at = base + seconds(pos as i64, s.sample_rate);
+        view.lock().unwrap().push(Presentation {
+            system_delay_samples: engine.latency,
+            sample_rate: s.sample_rate,
+            samples_per_second: s.sample_rate.as_f64(),
+            ..block(at, pos as f64, 4096., Duration::ZERO)
+        });
+        // Poll the real route at each half-millisecond of this rendered block.
+        for f in (pos.div_ceil(stride) * stride..pos + 4096).step_by(stride) {
+            let now = base + seconds(f as i64, s.sample_rate);
+            port.poll("arp", now, &s, &view, &stats, &mut scratch);
+            for (_, m) in port.link.as_mut().unwrap().messages.drain(..) {
+                if m == [CLOCK] {
+                    if pulse % 24 == 0 {
+                        clocks.push(f);
+                    }
+                    pulse += 1;
+                }
+            }
+        }
+    }
+    let count = clicks.len().min(clocks.len());
+    assert!(count >= beats, "render {} send {}", clicks.len(), clocks.len());
+    let error = clicks.iter().zip(&clocks).map(|(a, b)| a.abs_diff(*b)).max().unwrap();
+    println!(
+        "B7 hz={hz} beats={beats} rendered={} dispatch={} matched={count} actual_pdc={} max_pulse_vs_audio_samples={error} max_ms={}",
+        clicks.len(),
+        clocks.len(),
+        engine.latency,
+        error as f64 * 1000. / hz as f64
+    );
+    assert!(error * 1000 <= hz as usize);
+}
