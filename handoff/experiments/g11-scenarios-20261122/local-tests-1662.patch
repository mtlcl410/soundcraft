+use super::*;
+use soundcraft_time::{SampleRate, TICKS_PER_QUARTER};
+const TPC: i64 = TICKS_PER_QUARTER / 24;
+
+fn seconds(n: i64, rate: SampleRate) -> Duration {
+    Duration::from_secs_f64(n as f64 / rate.as_f64())
+}
+fn distance(a: Instant, b: Instant) -> Duration {
+    a.saturating_duration_since(b).max(b.saturating_duration_since(a))
+}
+fn test_rate(rate: u32) -> SampleRate {
+    SampleRate::new(rate).unwrap()
+}
+
+/// Calls the actual encoder on an independent 125-us worker lattice.
+/// Compares both its tagged presentation time and the tick handed to the sink.
+fn check_map(s: &Session, pulses: i64) -> (f64, f64, f64) {
+    let start = Instant::now();
+    let mut cursor = Cursor::default();
+    let rate = s.sample_rate;
+    let mut b = block(start, 0., 1e14, Duration::ZERO);
+    b.sample_rate = rate;
+    b.samples_per_second = rate.as_f64();
+    let mut previous: Option<(Instant, Instant)> = None;
+    let mut max_target = Duration::ZERO;
+    let mut max_hand = Duration::ZERO;
+    let mut max_interval = Duration::ZERO;
+    for n in 0..pulses {
+        let ideal = start + seconds(s.tempo.tick_to_samples(n * TPC, rate), rate);
+        let us = ideal.duration_since(start).as_nanos().div_ceil(125000) as u64 * 125;
+        let now = start + Duration::from_micros(us);
+        let mut count = 0;
+        cursor.update(b, now, s, &mut |stamp, m| {
+            if m == [CLOCK] {
+                count += 1;
+                max_target = max_target.max(distance(stamp, ideal));
+                max_hand = max_hand.max(distance(now, ideal));
+                if let Some((prev, should)) = previous {
+                    max_interval = max_interval.max((now - prev).abs_diff(ideal - should));
+                }
+                previous = Some((now, ideal));
+            }
+        });
+        assert_eq!(count, 1, "pulse {n} at {us} us");
+    }
+    (max_target.as_secs_f64() * 1000., max_hand.as_secs_f64() * 1000., max_interval.as_secs_f64() * 1000.)
+}
+fn position_messages(s: &Session, tick: i64, playing: bool) -> Vec<Vec<u8>> {
+    let now = Instant::now();
+    let at = s.tempo.tick_to_samples(tick, s.sample_rate) as f64;
+    let b = Presentation {
+        playing,
+        origin: at as i64,
+        sample_rate: s.sample_rate,
+        samples_per_second: s.sample_rate.as_f64(),
+        ..block(now, at, 4096., Duration::ZERO)
+    };
+    let mut m = Vec::new();
+    Cursor::default().update(b, now, s, &mut |_, bytes| m.push(bytes.to_vec()));
+    m
+}
+fn spp(messages: &[Vec<u8>]) -> Option<i64> {
+    messages.iter().find_map(|m| match m.as_slice() {
+        [0xf2, l, h] => Some(*l as i64 + 128 * (*h as i64)),
+        _ => None,
+    })
+}
+#[test]
+fn a7_three_destinations() {
+    let start = Instant::now();
+    let lead = Duration::from_millis(300);
+    for hz in [44100, 48000, 96000, 192000] {
+        let srate = test_rate(hz);
+        let mut s = Session::new("DJ", srate);
+        s.tempo.set_tempo(0, 128.).unwrap();
+        s.tempo.set_tempo(16 * TICKS_PER_QUARTER, 140.).unwrap();
+        let view = View::default();
+        let stats = Stats::default();
+        let mut events = Vec::new();
+        let cap = i64::from(hz) / 4;
+        let offsets = [-cap, 0, cap];
+        let mut ports = offsets.map(|o| active_port(o, true));
+        let mut idx = [0i64; 3];
+        let mut peaks = [0u64; 3];
+        let mut labels = [0u64; 3];
+        for us in (0..10_000_000).step_by(500) {
+            let now = start + Duration::from_micros(us);
+            if us % 10_000 == 0 {
+                view.lock().unwrap().push(Presentation {
+                    sample_rate: srate,
+                    samples_per_second: srate.as_f64(),
+                    ..block(now, us as f64 * srate.as_f64() / 1e6, srate.as_f64() / 100., lead)
+                });
+            }
+            for (i, p) in ports.iter_mut().enumerate() {
+                p.poll("DIN", now, &s, &view, &stats, &mut events);
+                for (stamp, m) in p.link.as_mut().unwrap().messages.drain(..) {
+                    if m == [CLOCK] {
+                        let target = start + lead + seconds(s.tempo.tick_to_samples(idx[i] * TPC, srate), srate);
+                        let target = crate::sync_clock::shift(target, offsets[i] as f64 / srate.as_f64());
+                        peaks[i] = peaks[i].max(distance(now, target).as_micros() as u64);
+                        labels[i] = labels[i].max(distance(stamp, target).as_micros() as u64);
+                        idx[i] += 1;
+                    }
+                }
+            }
+        }
+        println!("A7 hz={hz} count={idx:?} peak_actual_us={peaks:?} peak_target_us={labels:?}");
+        assert!(idx.iter().all(|n| *n > 384) && peaks.iter().all(|n| *n <= 1000));
+        assert_eq!(effective_offset(2 * cap, srate), cap);
+        assert_eq!(effective_offset(-2 * cap, srate), -cap);
+    }
+}
+fn setlist_at(hz: u32) -> Session {
