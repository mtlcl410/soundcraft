+        s.tempo.set_tempo(base, (95 + i) as f64).unwrap();
+        let sample = s.tempo.tick_to_samples(base, s.sample_rate);
+        s.add_marker(&format!("Song {}", i + 1), soundcraft_model::MarkerKind::Marker, sample, sample);
+        for j in 0..=8 {
+            s.tempo.set_tempo(base + (8 + j) * TICKS_PER_QUARTER, 120. - 5. * j as f64).unwrap();
+        }
+    }
+    s
