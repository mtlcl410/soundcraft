+/// The first delivery after a 100-ms interval without a device lead must be
+/// checked at the instant the receiver sees F8, even if its tag is on grid.
+#[test]
+fn a10_first_clock_after_unknown_lead_is_handed_off_on_time() {
+    struct ClockWire {
+        now: Instant,
+        writes: Vec<(Instant, Instant)>,
+    }
+    impl SyncPort for ClockWire {
+        fn send_at(&mut self, deadline: Instant, bytes: &[u8]) -> Result<Instant, String> {
+            if bytes == [CLOCK] {
+                self.writes.push((deadline, self.now));
+            }
+            Ok(self.now)
+        }
+    }
+    let base = Instant::now();
+    let mut routes = BTreeMap::new();
+    set_route(&mut routes, 0, "desk".into(), Route { map: None, offset: 0, compensate: true, encoder: Box::<Cursor>::default() });
+    let port = routes.get_mut("desk").unwrap();
+    port.link = Some(ClockWire { now: base, writes: Vec::new() });
+    let song = Session::new("reset", test_rate(48000));
+    let view = View::default();
+    let stats = Stats::default();
+    let mut pending = Vec::new();
+    for ms in 0..=400 {
+        let now = base + Duration::from_millis(ms);
+        if ms % 10 == 0 {
+            let lead = (!(100..200).contains(&ms)).then_some(Duration::ZERO);
+            view.lock().unwrap().push(Presentation { lead, ..block(now, ms as f64 * 48., 480., Duration::ZERO) });
+        }
+        port.link.as_mut().unwrap().now = now;
+        port.poll("desk", now, &song, &view, &stats, &mut pending);
+    }
+    let writes = &port.link.as_ref().unwrap().writes;
+    let valid_again = base + Duration::from_millis(200);
+    let unknown_start = base + Duration::from_millis(100);
+    let while_unknown = writes.iter().filter(|(_, at)| (unknown_start..valid_again).contains(at)).count();
+    let recovered: Vec<_> = writes.iter().filter(|(_, at)| *at >= valid_again).collect();
+    let (due, handed) = *recovered[0];
+    let late = handed.saturating_duration_since(due);
+    let stale = recovered.iter().filter(|(d, _)| *d < valid_again).count();
+    println!(
+        "A10 F8 only unknown_ms=100 packets_while_unknown={while_unknown} recovery_packets={} stale_after_recovery={stale} first_due_ms={:.6} first_handoff_ms={:.6} first_handoff_late_ms={:.6}",
+        recovered.len(),
+        (due - base).as_secs_f64() * 1000.,
+        (handed - base).as_secs_f64() * 1000.,
+        late.as_secs_f64() * 1000.
+    );
+    for (due, at) in recovered.iter().take(7).copied() {
+        println!("A10 recovered_F8 due_ms={:.6} handoff_ms={:.6}", (*due - base).as_secs_f64() * 1000., (*at - base).as_secs_f64() * 1000.);
+    }
+    assert_eq!(while_unknown, 0);
+    assert!(
+        late <= Duration::from_millis(1),
+        "first F8 missed the proposed one-millisecond handoff target by {:?}",
+        late.saturating_sub(Duration::from_millis(1))
+    );
+}
