+#[test]
+fn d5_missing_calibrated_name_is_reported_without_substituting_renamed_device() {
+    let out = Output::default();
+    let view = out.view.clone();
+    let trouble = out.trouble.clone();
+    let stats = out.stats.clone();
+    let requested = Arc::new(Mutex::new(Vec::new()));
+    let seen = requested.clone();
+    let (tx, rx) = channel();
+    let worker = std::thread::spawn(move || {
+        drive(view, Arc::new(Session::default()), rx, trouble, stats, move |name| {
+            seen.lock().unwrap().push(name.to_owned());
+            if name == "Deck 2" { Ok((FakePort::default(), None)) } else { Err(format!("MIDI output {name} unavailable")) }
+        })
+    });
+    tx.send(Update::Beats(vec![("Deck".into(), -2501)], true)).unwrap();
+    let end = Instant::now() + Duration::from_secs(2);
+    let msg = loop {
+        if let Some(e) = out.status().error {
+            break e;
+        }
+        assert!(Instant::now() < end);
+        std::thread::yield_now();
+    };
+    drop(tx);
+    worker.join().unwrap();
+    let attempts = requested.lock().unwrap().clone();
+    println!("D5 missing_name=Deck available_name=Deck_2 open_attempts={attempts:?} status={msg}");
+    assert_eq!(msg, "MIDI output Deck unavailable");
+    assert!(attempts.iter().all(|p| p == "Deck"));
+}
